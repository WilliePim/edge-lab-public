# Copia questo file come `.env` e compilalo.
#
# DOVE. Il caricatore risale le directory a partire dal package, quindi il file
# funziona sia qui accanto sia piu' in alto. Se questo package vive dentro un
# repo piu' grande, mettilo alla RADICE di quel repo e non qui: `edgar_llm/` e'
# cio' che viene pubblicato, e un segreto non va dentro la directory che si
# pubblica. La guardia del perimetro segnala una chiave trovata qui dentro --
# anche una finta, perche' a occhio non si distinguono.
#
# CHI VINCE. L'ambiente del processo ha sempre la precedenza su questo file: una
# variabile gia' esportata non viene sovrascritta. Serve a far scavalcare a uno
# scheduler o a una CI un `.env` vecchio rimasto su disco.
#
# COSA VEDE IL CODICE, senza stampare niente di segreto:
#     python -m edgar_llm.config

# Obbligatorio: la SEC blocca le richieste senza nome e contatto reali
# (forma: "edge-lab Nome Cognome tu@dominio.tld").
EDGAR_USER_AGENT=

# Senza chiave il modulo gira solo in EDGAR_LLM_MODE=replay, servendosi dalla
# cache. Chi lo chiama deve degradare, non fallire.
ANTHROPIC_API_KEY=

# Solo per le chiavi legate a un'identita'. Senza, l'API risponde 400 con
# «anthropic-workspace-id is required». Vuoto = non si manda l'header.
ANTHROPIC_WORKSPACE_ID=

# record = chiama l'API quando manca in cache e scrive
# replay = solo cache, nessuna chiamata, nessuna chiave
# vuoto = record
EDGAR_LLM_MODE=
