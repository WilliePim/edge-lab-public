# Copia questo file come `.env` alla radice di edge-lab e compilalo: solo nomi qui, mai valori.
# L'ambiente del processo vince sempre sul file. Diagnosi senza stampare segreti: python -m edgar_llm.config

# Obbligatorio per EDGAR: la SEC blocca le richieste senza nome e contatto reali ("Nome Cognome email").
EDGAR_USER_AGENT=

# Radice dell'archivio prezzi di market-data: percorso ASSOLUTO fuori da qualsiasi repo git (la configurazione rifiuta il contrario).
MARKET_DATA_DIR=

# Chiave EOD Historical Data: serve solo per scaricare; non compare mai in messaggi, log o manifest.
EODHD_API_KEY=

# Chiamate al giorno del piano EODHD (vuoto = 100000; il client ne usa il 90%).
EODHD_DAILY_LIMIT=

# Chiamate al minuto del piano EODHD (vuoto = 1000; il client ne usa il 90%).
EODHD_MINUTE_LIMIT=

# Chiave Anthropic per edgar_llm/: senza, il modulo gira solo in EDGAR_LLM_MODE=replay.
ANTHROPIC_API_KEY=

# Solo per le chiavi legate a un'identita' (altrimenti 400); vuoto = non si manda l'header.
ANTHROPIC_WORKSPACE_ID=

# record = chiama l'API quando manca in cache e scrive; replay = solo cache, nessuna chiave.
EDGAR_LLM_MODE=

# Interruttore della colonna LLM nel report giornaliero: spento se vuoto, acceso con 1/true/si/yes/on.
EDGAR_LLM_DAILY=

# Veto sulla diluizione dello scanner: implementato, disattivato finche' non e' validato. Vuoto/0 = spento (il
# predicato e' solo un flag); 1/true/si/yes/on = acceso. Lo scanner lo legge dall'ambiente del processo, non da .env.
EDGE_LAB_DILUTION_VETO=
